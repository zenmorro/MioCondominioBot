# Copia questo file in ".env" e compila i valori.

# --- Portale miocondominio.eu ---
URL='https://www.miocondominio.eu/'
PORTAL_PID='0000'            # codice condominio (pid) fornito dall'amministratore
PORTAL_USER='00000'          # codice utente (login)
PORTAL_PASSWORD='xxxxxxxxxx' # password (attenzione: case-sensitive)

# --- Telegram ---
TELEGRAM_TOKEN_BOT='000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'  # token da @BotFather

# Uno o più id abilitati, separati da virgola. Es. un solo id:  574520558
# Es. più persone:  574520558,123456789,987654321
# (per scoprire il tuo id scrivi a @userinfobot su Telegram)
TELEGRAM_ID_OWNER='000000000'

# --- Opzionale ---
POLL_MINUTES='15'            # ogni quanti minuti controllare il portale (default 15)

# --- Notifiche WhatsApp via OpenWA (opzionale) ---
# https://github.com/rmyndharis/OpenWA
# Se questi valori sono vuoti le notifiche WhatsApp restano disattivate
# (le notifiche Telegram continuano a funzionare normalmente).
OPENWA_URL='http://localhost:2785'       # indirizzo dell'istanza OpenWA (porta di default: 2785)
OPENWA_API_KEY='xxxxxxxxxxxxxxxx'         # API key generata nella dashboard OpenWA (header X-API-Key)
OPENWA_SESSION='default'                  # nome della sessione OpenWA già creata e avviata
# Uno o più destinatari, separati da virgola.
# - Persona:  numero con prefisso internazionale senza + (es. 393331234567) oppure 393331234567@c.us
# - Gruppo:   chatId completo del gruppo, es. 120363321228375767@g.us
# Esempio con persona + gruppo:  393331234567,120363321228375767@g.us
OPENWA_RECIPIENTS='120363321228375767@g.us'
